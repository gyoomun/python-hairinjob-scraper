# PostgreSQL Docker 설정
# 실제 사용 시 이 파일을 .env로 복사하고 값을 수정하세요
# cp .env.example .env

# === Docker 실행 명령어 ===
# 주의: 포트 5432는 biseo-postgres가 사용 중이므로 5433 사용
# docker run -d \
#   --name hairinjob-postgres \
#   -e POSTGRES_DB=hairinjob \
#   -e POSTGRES_USER=hairinjob_user \
#   -e POSTGRES_PASSWORD=hairinjob2024! \
#   -p 5433:5432 \
#   -v hairinjob_pgdata:/var/lib/postgresql/data \
#   postgres:15-alpine

# === 데이터베이스 접속 정보 ===
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hairinjob
DB_USER=hairinjob_user
DB_PASSWORD=hairinjob2024!

# === DataGrip / DBeaver 접속 정보 ===
# Host: localhost
# Port: 5433 (외부 포트, 컨테이너 내부는 5432)
# Database: hairinjob
# User: hairinjob_user
# Password: hairinjob2024!
# JDBC URL: jdbc:postgresql://localhost:5433/hairinjob
